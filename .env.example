# ═══════════════════════════════════════════════════════════════
#  UNUM — muhit o'zgaruvchilari namunasi
#  Nusxa oling:  cp .env.example .env
#  Haqiqiy qiymatlar HECH QACHON repozitoriyga tushmaydi (.gitignore).
# ═══════════════════════════════════════════════════════════════

# ─── Server ───────────────────────────────────────────────────
PORT="3000"
NODE_ENV="production"

# SQLite fayli qayerda tursin (bo'sh bo'lsa — server yonida).
DB_PATH=""

# Backend'ning public manzili. OAuth redirect URI shundan yasaladi.
APP_PUBLIC_URL="https://your-server.example.com"

# ─── Xavfsizlik ───────────────────────────────────────────────
# Kamida 32 belgi. Ishlab chiqarishda bo'lmasa server ishga tushmaydi.
#   openssl rand -hex 32
JWT_SECRET=""

# Integratsiya tokenlarini shifrlash kaliti (AES-256-GCM), 32 bayt hex.
#   openssl rand -hex 32
TOKEN_ENC_KEY=""

# ─── OpenAI ───────────────────────────────────────────────────
# https://platform.openai.com/api-keys
OPENAI_API_KEY=""
# Vision + JSON qo'llab-quvvatlaydigan arzon standart.
OPENAI_MODEL="gpt-4o-mini"
# Hisob boshiga kunlik AI so'rovlar chegarasi — xarajat nazorati.
AI_DAILY_LIMIT="60"

# ─── Google OAuth (Cloud Console → Auth → Clients) ────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Android mijozi (SHA-1 bilan ro'yxatdan o'tgan)
GOOGLE_ANDROID_CLIENT_ID=""

# ─── Apple Sign In ────────────────────────────────────────────
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""

# ─── Telegram bot ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
TELEGRAM_ADMIN_ID=""
# Bot bu kanalda ADMIN bo'lishi shart — aks holda obunani tekshira olmaydi.
TELEGRAM_CHANNEL=""

# ─── Obuna ────────────────────────────────────────────────────
# Narxlar BUTUN SO'MDA. Hech qanday valyuta konvertatsiyasi yo'q.
PRICE_MONTH="49000"
PRICE_HALF_YEAR="249000"
PRICE_YEAR="399000"

# Dastlabki N foydalanuvchiga bepul Premium.
PROMO_LIMIT="500"

# ⚠️ To'lov provayderi (Click Merchant API) sozlamalari bu namunada
#    keltirilmagan — integratsiya yopiq manba sifatida saqlanadi.
#    Batafsil: `click.ts` faylidagi izoh.
